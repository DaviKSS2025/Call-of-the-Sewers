.inventory-root {
    display: none;
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(8, 10, 11);
    color: rgb(226, 224, 214);
}

.inventory-root--hidden {
    display: none;
}

.inventory-tabs {
    flex-direction: column;
    width: 96px;
    min-width: 96px;
    padding-left: 12px;
    padding-right: 8px;
    padding-top: 22px;
    padding-bottom: 22px;
    background-color: rgb(18, 24, 25);
    border-right-width: 2px;
    border-right-color: rgb(67, 83, 78);
}

.inventory-tab {
    position: relative;
    width: 72px;
    height: 92px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    background-color: rgb(31, 38, 38);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(68, 78, 75);
    border-right-color: rgb(68, 78, 75);
    border-top-color: rgb(68, 78, 75);
    border-bottom-color: rgb(68, 78, 75);
}

.inventory-tab:hover {
    background-color: rgb(42, 51, 50);
}

.inventory-tab--active {
    width: 84px;
    background-color: rgb(82, 75, 51);
    border-left-color: rgb(169, 146, 81);
    border-right-color: rgb(169, 146, 81);
    border-top-color: rgb(169, 146, 81);
    border-bottom-color: rgb(169, 146, 81);
}

/* ESPAÇO PARA IMAGEM DO ÍCONE DA ABA */
.tab-icon {
    width: 34px;
    height: 34px;
    background-color: rgb(98, 112, 104);
    border-radius: 0;
}

.tab-label {
    display: none;
    position: absolute;
    width: 150px;
    height: 34px;
    left: -34px;
    bottom: 28px;
    rotate: -90deg;
    transform-origin: center;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(245, 229, 174);
    white-space: nowrap;
}

.inventory-tab--active .tab-icon {
    position: absolute;
    top: 8px;
}

.inventory-tab--active .tab-label {
    display: flex;
}

.inventory-content {
    flex-grow: 1;
    flex-direction: column;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 20px;
    padding-bottom: 20px;
}

.item-details-panel {
    height: 320px;
    flex-direction: row;
    margin-bottom: 16px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: rgb(22, 28, 28);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(67, 83, 78);
    border-right-color: rgb(67, 83, 78);
    border-top-color: rgb(67, 83, 78);
    border-bottom-color: rgb(67, 83, 78);
}

/* ESPAÇO PARA IMAGEM GRANDE DO ITEM */
.selected-item-icon {
    width: 220px;
    height: 220px;
    margin-right: 18px;
    align-self: center;
    background-color: rgb(52, 62, 58);
    -unity-background-scale-mode: scale-to-fit;
}

.item-details-text {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
}

.empty-state-label {
    font-size: 44px;
    color: rgb(137, 146, 139);
    -unity-text-align: middle-left;
}

.selected-item-name {
    display: none;
    font-size: 60px;
    color: rgb(242, 231, 190);
    margin-bottom: 8px;
}

.selected-item-effect {
    display: none;
    font-size: 34px;
    color: rgb(175, 211, 194);
    margin-bottom: 10px;
}

.selected-item-lore {
    display: none;
    font-size: 30px;
    color: rgb(205, 202, 190);
    white-space: normal;
}

.items-scroll {
    flex-grow: 1;
    background-color: rgb(14, 18, 18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(45, 57, 54);
    border-right-color: rgb(45, 57, 54);
    border-top-color: rgb(45, 57, 54);
    border-bottom-color: rgb(45, 57, 54);
}

.inventory-items-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.inventory-item-row {
    width: 48%;
    min-height: 104px;
    flex-direction: row;
    align-items: center;
    margin-left: 1%;
    margin-right: 1%;
    margin-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgb(29, 35, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(69, 82, 77);
    border-right-color: rgb(69, 82, 77);
    border-top-color: rgb(69, 82, 77);
    border-bottom-color: rgb(69, 82, 77);
}

.inventory-item-row:hover {
    background-color: rgb(43, 51, 49);
}

.inventory-item-row--selected {
    background-color: rgb(75, 67, 47);
    border-left-color: rgb(178, 151, 81);
    border-right-color: rgb(178, 151, 81);
    border-top-color: rgb(178, 151, 81);
    border-bottom-color: rgb(178, 151, 81);
}

/* ESPAÇO PARA ÍCONE DO ITEM NA LISTA */
.inventory-item-icon {
    width: 72px;
    height: 72px;
    margin-right: 12px;
    background-color: rgb(83, 96, 90);
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-item-name {
    flex-grow: 1;
    font-size: 32px;
    color: rgb(229, 225, 209);
    white-space: normal;
}
