.combat-ui {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(50, 50, 50);
    border-right-color: rgb(50, 50, 50);
    border-top-color: rgb(50, 50, 50);
    border-bottom-color: rgb(50, 50, 50);
}

.target-name {
    position: absolute;
    top: 4px;
    left: 32%;
    width: 36%;
    height: 18px;
    background-color: rgb(160, 160, 160);
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.combat-text {
    position: absolute;
    left: 8px;
    bottom: 136px;
    color: white;
    font-size: 20px;
}

.bottom-area {
    position: absolute;
    left: 12px;
    right: 8px;
    bottom: 6px;
    height: 114px;
    flex-direction: row;
    align-items: flex-end;
}

.menuActions {
    width: 102px;
    height: 108px;
    margin-right: 6px;
    padding: 4px;
    background-color: rgb(72, 72, 72);
    justify-content: flex-end;
}

.command-button {
    height: 34px;
    margin-bottom: 2px;
    border-radius: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(230, 230, 230);
    font-size: 20px;
    -unity-text-align: middle-center;
}

.command-button:hover {
    color: white;
}

.command-button:active {
    background-color: rgb(180, 180, 180);
    color: black;
}

.command-button.selected {
    background-color: rgb(232, 232, 232);
    color: rgb(70, 70, 70);
}

.menuCharacter {
    flex-grow: 1;
    height: 120px;
    margin-bottom: -6px;
    padding: 6px 8px 6px 8px;
    background-color: rgb(210, 0, 150);
    flex-direction: column;
    justify-content: flex-start;
}

.character-container {
    height: 36px;
    margin-bottom: 2px;
    flex-direction: row;
    justify-content: space-between;
}

.character-name {
    width: 21%;
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.bars-panel {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.bar-group {
    width: 208px;
    height: 100%;
    margin-left: 8px;
    justify-content: center;
}

.bar-value {
    height: 24px;
    color: white;
    font-size: 20px;
    -unity-text-align: upper-right;
}

.bar-frame {
    height: 6px;
    background-color: rgba(40, 40, 40, 0.45);
}

.bar-fill {
    height: 100%;
    width: 100%;
}

.vitality-fill {
    background-color: rgb(196, 31, 15);
}

.sanity-fill {
    background-color: rgb(40, 88, 220);
}
