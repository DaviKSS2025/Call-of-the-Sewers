/* Area raiz do menu principal. */
.main-menu-ui {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-left-color: rgb(50, 50, 50);
    border-right-color: rgb(50, 50, 50);
    border-top-color: rgb(50, 50, 50);
    border-bottom-color: rgb(50, 50, 50);
}

/* Camada de fundo que recebe a imagem principal do menu. */
.background {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 2px;
    bottom: 6px;
    background-color: rgb(194, 111, 113);
    -unity-background-scale-mode: scale-and-crop;
}

/* Area separada para a imagem/logo do titulo do jogo. */
.titleImage {
    position: absolute;
    left: 25%;
    right: 25%;
    top: 70px;
    height: 110px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

/* Container centralizado que agrupa os botoes do menu. */
.containerButtons {
    position: absolute;
    left: 50%;
    top: 210px;
    width: 150px;
    margin-left: -75px;
}

/* Estilo base compartilhado por Continue, New game e Quit. */
.main-menu-button {
    height: 30px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 4px;
    border-radius: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-top-color: rgb(85, 85, 85);
    border-bottom-color: rgb(85, 85, 85);
    background-color: rgb(238, 238, 238);
    color: rgb(50, 50, 50);
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* Estado visual quando o mouse passa sobre o botao. */
.main-menu-button:hover {
    background-color: rgb(210, 210, 210);
    color: black;
}

/* Estado visual durante o clique. */
.main-menu-button:active {
    background-color: rgb(180, 180, 180);
}
